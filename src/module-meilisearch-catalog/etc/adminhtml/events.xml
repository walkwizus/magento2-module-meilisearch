<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_entity_attribute_save_after">
        <observer name="add_meilisearch_attribute_settings" instance="Walkwizus\MeilisearchCatalog\Observer\AddAttributeSettings" />
    </event>
    <event name="admin_system_config_changed_section_currency">
        <observer name="invalidate_meilisearch_product_index_on_currency_change" instance="Walkwizus\MeilisearchCatalog\Observer\InvalidateProductIndexOnCurrencyConfigChange" />
    </event>
</config>
